{
  "name": "lean-electron-vue",
  "private": true,
  "version": "2.0.0",
  "description": "An out-of-the-box desktop app template built with Vite + Electron + Vue 3 + TypeScript.",
  "author": "桥头的小屁孩",
  "license": "MIT",
  "keywords": [
    "electron",
    "vite",
    "vue3",
    "typescript",
    "element-plus",
    "electron-builder",
    "electron-updater",
    "template"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "dist": "node ./scripts/dist.mjs",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit && vue-tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "4.0.9",
    "@types/node": "^24.0.0",
    "@types/qs": "^6.15.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "animate.css": "^4.1.1",
    "axios": "^1.20.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "element-plus": "^2.14.7",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "js-yaml": "^5.5.0",
    "pinia": "^4.1.0",
    "prettier": "^3.9.10",
    "qs": "^6.16.1",
    "sass": "^1.106.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-eslint-parser": "^10.4.1",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrcen3204097569-spec/lean-electron-vue.git"
  },
  "homepage": "https://github.com/mrcen3204097569-spec/lean-electron-vue#readme",
  "bugs": {
    "url": "https://github.com/mrcen3204097569-spec/lean-electron-vue/issues"
  }
}
