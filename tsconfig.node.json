{
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./src/renderer/*"]
    }
  },
  "include": [
    "vite.config.mts",
    "vitest.config.mts",
    "plugins/**/*.mts",
    "config/**/*.mts",
    "tests/**/*.ts",
    "src/renderer/types/**/*.d.ts",
    "src/renderer/auto-imports.d.ts"
  ]
}
